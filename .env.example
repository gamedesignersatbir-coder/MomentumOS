# Copy to .env.local for local dev; set the same in Netlify for production.

# Supabase project (Settings → API in the Supabase dashboard).
# SUPABASE_KEY: the secret key is preferred; the publishable key also works
# while RLS is off. Either way the key stays server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_key

# The passcode you type on the login screen (make it long)
APP_PASSCODE=choose-a-long-passcode

# Random secret for signing the session cookie (any long random string)
AUTH_SECRET=generate-a-long-random-string

# OpenRouter key — powers the tutor and the monthly letter
OPENROUTER_API_KEY=sk-or-...
